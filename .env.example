# Copy this file to .env and replace every CHANGE_ME value. Never commit .env.
DB_URL=jdbc:mysql://CHANGE_ME:3306/qgents?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
REDIS_HOST=CHANGE_ME
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DATABASE=0
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_BYTES
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=qgents@qq.com
SMTP_AUTH_CODE=CHANGE_ME_QQ_MAIL_AUTH_CODE
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
RSA_PRIVATE_KEY_PATH=file:/opt/qgents/secrets/private_key.pem
RSA_KEY_ID=rsa-2026-08
